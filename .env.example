# Caminho ABSOLUTO no host que contém seus projetos (obrigatório)
# Ex: /home/usuario/projects
WORKSPACE_DIR=

# Profiles Docker (vazio = só o dev-sandbox; "db,auth" = + bancos + Keycloak)
COMPOSE_PROFILES=

# Git — identidade para commits dentro do container
GIT_USER_NAME=dev
GIT_USER_EMAIL=dev@local

# GitHub — token (fine-grained PAT com escopo "repo" ou classic PAT com escopo repo)
# Fica setado como env var no container (trade-off aceito: todo processo
# filho herda; o alcance é contido pelo firewall) e, no boot, é persistido
# no gh config (~/.config/gh, volume gh-config) para o git credential helper.
# Gere em: https://github.com/settings/tokens
GH_TOKEN=

# Ollama / LLM local — IP do servidor que roda o Ollama (usado pelo firewall)
# Ex: 192.168.1.50
OLLAMA_HOST=
