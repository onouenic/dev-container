#!/bin/sh
# Wrapper do pnpm: injeta GITHUB_TOKEN (token só de leitura do GitHub
# Packages, secret gh_packages_token) apenas nos subcomandos que baixam
# pacotes, para o .npmrc dos projetos autenticar em npm.pkg.github.com
# (@nicbrasil). Nos demais subcomandos (run, test, exec...) o token não é
# exportado.
. /opt/sandbox/lib/pkg-token.sh

VALUE_FLAGS="-C --dir -F --filter --filter-prod --loglevel --reporter --store-dir"

case "$(subcommands 1 "$@")" in
    install|i|add|update|up|upgrade|fetch|dlx|outdated)
        export_pkg_token
        ;;
esac

exec /usr/local/bin/pnpm "$@"
