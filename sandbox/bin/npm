#!/bin/sh
# Wrapper do npm: injeta GITHUB_TOKEN (token só de leitura do GitHub
# Packages, secret gh_packages_token) apenas nos subcomandos que baixam
# pacotes, para o .npmrc dos projetos autenticar em npm.pkg.github.com
# (@nicbrasil). Nos demais subcomandos (run, test, exec, publish...) o token não é
# exportado.
. /opt/sandbox/lib/pkg-token.sh

VALUE_FLAGS="-C --prefix -w --workspace --loglevel --registry --userconfig --cache"

case "$(subcommands 1 "$@")" in
    install|i|ci|add|update|up|upgrade|outdated|view|info)
        export_pkg_token
        ;;
esac

exec /usr/local/bin/npm "$@"
